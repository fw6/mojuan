# Local
.DS_Store
*.local
*.log*

# 依赖与构建产物（.pnpm 是 pnpm 的 store 链接目录，含 crate 归档）
node_modules
.pnpm/
target/
dist/
build/

# IDE
.vscode/*
!.vscode/extensions.json
.idea

# TypeScript
*.tsbuildinfo

# 本机工具状态（ZCode 与 video2code 插件缓存）
.zcode/
.v2c/

# 探针中间产物（render_probe dump）
apps/mojuan/.probe/

# Cloudflare Worker 更新通道（apps/updater/）
apps/updater/.dev.vars
apps/updater/.wrangler/

# Android 发布签名密钥与产物（密钥只留本机一份，口令在 .env.local；丢了就发不出可覆盖安装的更新）
*.keystore
*.jks
*.apk
*.apk.idsig

# 中间结果（探针脚本、构建与运行日志）
.scratch/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
